<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AssemblyName>RebalancedCrests</AssemblyName>
        <!-- PlayMaker is built for x86 -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/</PathMap>
        <SilksongFolder>$(MSBuildProjectDirectory)/../../SteamLibrary/steamapps/common/Hollow Knight Silksong</SilksongFolder>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BepInEx.Core" Version="5.4.21"/>
        <PackageReference Include="HarmonyX" Version="2.9.0"/>
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile"/>
        <PackageReference Include="Silksong.GameLibs" Version="1.2.0-silksong1.0.30000" PrivateAssets="all"/>
    </ItemGroup>
    <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(SilksongFolder)')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SilksongFolder)/BepInEx/plugins/$(AssemblyName)/"/>
    </Target>
</Project>
